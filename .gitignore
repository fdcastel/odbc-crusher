/old-odbc-crusher

# Build directories
build/
cmake-build-*/
out/

# Generated files — version.hpp is generated into the build tree (E2), so
# there is nothing to ignore in the source tree any more. Kept as a note so
# nobody re-adds the entry along with a source-tree configure_file().

# Temporary files
tmp/

# JSON reports written by the Appendix's own verification commands.
report.json
report-*.json

# IDE files
.vs/
.vscode/
.idea/
.claude/
# …but project-level Claude Code skills are repo-tracked. Negate the
# skills/ subtree so committing them doesn't require `git add -f`.
!.claude/
.claude/*
!.claude/skills/
!.claude/skills/**
*.swp
*.swo
*~

