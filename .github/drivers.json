{
  "schema_version": 1,
  "_about": "Manifest of ODBC drivers under stress-test. Single source of truth for (a) the version of each driver to install in CI, (b) the URL/apt package to install it from, and (c) the upstream git repo + tag whose source matches that binary version. Consumed by .github/workflows/stress-test.yml at runtime via `jq` and by the /triage-driver skill at analysis time. apt_version strings are formatted for `apt-get install pkg=version`; if Ubuntu drops a pinned version from its repos the workflow will fail loudly at the install step and this file must be updated. The `version` field is the upstream form (what SQLGetInfo reports); apt_version is the Debian-formatted form. Firebird is intentionally absent until its driver refactor lands.",

  "drivers": {
    "postgresql": {
      "display_name": "PostgreSQL (psqlodbc)",
      "version": "16.00.0000",
      "install": {
        "method": "apt",
        "package": "odbc-postgresql",
        "apt_version": "1:16.00.0000-0.4-1build1"
      },
      "source": {
        "repo": "https://github.com/postgresql-interfaces/psqlodbc",
        "tag": "REL-16_00_0000"
      },
      "conn_string": "Driver={PostgreSQL Unicode};Server=127.0.0.1;Port=5432;Database=postgres;Uid=postgres;Pwd=postgres;",
      "platform": "linux"
    },

    "mariadb": {
      "display_name": "MariaDB Connector/ODBC",
      "version": "3.1.15",
      "install": {
        "method": "apt",
        "package": "odbc-mariadb",
        "apt_version": "3.1.15-1build3"
      },
      "source": {
        "repo": "https://github.com/mariadb-corporation/mariadb-connector-odbc",
        "tag": "3.1.15"
      },
      "conn_string": "Driver={MariaDB Unicode};Server=127.0.0.1;Port=3306;User=root;Password=root;",
      "platform": "linux"
    },

    "mysql": {
      "display_name": "MySQL Connector/ODBC",
      "version": "9.2.0",
      "install": {
        "method": "binary_download",
        "url": "https://dev.mysql.com/get/Downloads/Connector-ODBC/9.2/mysql-connector-odbc-9.2.0-linux-glibc2.28-x86-64bit.tar.gz",
        "library_name": "libmyodbc9w.so",
        "driver_section": "MySQL"
      },
      "source": {
        "repo": "https://github.com/mysql/mysql-connector-odbc",
        "tag": "9.2.0"
      },
      "conn_string": "Driver={MySQL};Server=127.0.0.1;Port=3306;User=crusher;Password=crusher;",
      "platform": "linux"
    },

    "duckdb": {
      "display_name": "DuckDB ODBC",
      "version": "1.4.4.0",
      "install": {
        "method": "binary_download",
        "url": "https://github.com/duckdb/duckdb-odbc/releases/download/v1.4.4.0/duckdb_odbc-linux-amd64.zip",
        "library_name": "libduckdb_odbc.so",
        "driver_section": "DuckDB Driver"
      },
      "source": {
        "repo": "https://github.com/duckdb/duckdb-odbc",
        "tag": "v1.4.4.0"
      },
      "conn_string": "Driver={DuckDB Driver};",
      "platform": "linux"
    },

    "clickhouse": {
      "display_name": "ClickHouse ODBC",
      "version": "1.5.0.20251127",
      "install": {
        "method": "binary_download",
        "url": "https://github.com/ClickHouse/clickhouse-odbc/releases/download/v1.5.0.20251127/clickhouse-odbc-linux-Clang-UnixODBC-Release.zip",
        "library_name": "libclickhouseodbcw.so",
        "driver_section": "ClickHouse",
        "_note": "Server brought up via ClickHouse's own deb repo; server version is not part of the triage contract — only the driver version is pinned."
      },
      "source": {
        "repo": "https://github.com/ClickHouse/clickhouse-odbc",
        "tag": "v1.5.0.20251127"
      },
      "conn_string": "Driver={ClickHouse};Server=127.0.0.1;Port=8123;",
      "platform": "linux"
    },

    "mock-driver": {
      "display_name": "Mock ODBC Driver",
      "version": "workspace",
      "install": {
        "method": "release_asset",
        "url": "https://github.com/fdcastel/odbc-crusher/releases/latest/download/mock-odbc-driver-windows-x64.zip",
        "_note": "Mock driver is built from this repo; for triage the 'source' is the workspace itself, not a remote clone."
      },
      "source": {
        "repo": "self",
        "tag": "workspace",
        "_note": "Triage skill special-cases mock-driver — no clone step, points at this repo's mock-driver/ directory directly."
      },
      "conn_string": "Driver={Mock ODBC Driver};Mode=Success;Catalog=Default;ResultSetSize=100;",
      "platform": "windows"
    }
  }
}
